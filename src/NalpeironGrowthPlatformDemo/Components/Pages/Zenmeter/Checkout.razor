@page "/elevate/saas/{BillingProvider}/checkout"
@using Microsoft.Extensions.Options
@implements IDisposable
@inject IZenmeterDemo Demo
@inject IZenmeterPricingCatalog Catalog
@inject IOptions<BillingOptions> Billing
@inject ILogger<Checkout> Logger
@inject NavigationManager Nav
@inject BrowserStorage Storage
@inject PersistentComponentState ApplicationState

<PageTitle>Nalpeiron Growth Platform Demo Account - Checkout</PageTitle>

<TopBar/>

<main class="mx-auto max-w-2xl px-6 py-12">
    <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">SaaS subscription</p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">@_tierName</h1>
        <p class="mt-2 text-slate-500">@_summary</p>
        <p class="mt-2 text-xs font-semibold uppercase tracking-widest text-indigo-600">@_billingSystem.DisplayName() billing</p>
    </div>

    <EditForm Model="_input" FormName="zenmeter-checkout" OnValidSubmit="Submit"
              class="mx-auto mt-8 max-w-xl rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <DataAnnotationsValidator/>
        <fieldset>
            <legend class="text-sm font-bold uppercase tracking-wider text-slate-900">Customer</legend>
            <label class="mt-4 block">
                <span class="text-sm font-medium text-slate-700">Customer name</span>
                <InputText @bind-Value="_input.CustomerName" maxlength="120" placeholder="Acme Corp"
                           class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"/>
            </label>
            <ValidationMessage For="() => _input.CustomerName" class="mt-1 block text-sm text-rose-600"/>
        </fieldset>

        <fieldset class="mt-7 border-t border-slate-200 pt-6">
            <legend class="text-sm font-bold uppercase tracking-wider text-slate-900">Subscription user</legend>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
                <label class="block">
                    <span class="text-sm font-medium text-slate-700">First name</span>
                    <InputText @bind-Value="_input.UserFirstName" maxlength="50" placeholder="Alex"
                               class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"/>
                    <ValidationMessage For="() => _input.UserFirstName" class="mt-1 block text-sm text-rose-600"/>
                </label>
                <label class="block">
                    <span class="text-sm font-medium text-slate-700">Last name</span>
                    <InputText @bind-Value="_input.UserLastName" maxlength="50" placeholder="Morgan"
                               class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"/>
                    <ValidationMessage For="() => _input.UserLastName" class="mt-1 block text-sm text-rose-600"/>
                </label>
            </div>

            <label class="mt-4 block">
                <span class="text-sm font-medium text-slate-700">Email</span>
                <InputText @bind-Value="_input.UserEmail" maxlength="100" type="email"
                           placeholder="alex.morgan@acme.com"
                           class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"/>
            </label>
            <ValidationMessage For="() => _input.UserEmail" class="mt-1 block text-sm text-rose-600"/>
        </fieldset>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="mt-3 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700">@_error</p>
        }

        <div class="mt-6 flex items-center justify-end gap-3">
            <a role="button" href="@DemoRoutes.ZenmeterPricingFor(_billingSystem)"
               class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                Cancel
            </a>
            <SpinnerButton Type="submit" Variant="primary" Pill="false"
                           Busy="@_busy" Disabled="@(!_canPurchase)"
                           Label="@SubmitLabel" BusyLabel="Processing…"/>
        </div>
    </EditForm>
</main>

@code {
    [SupplyParameterFromQuery] public string? Sku { get; set; }
    [Parameter] public string? BillingProvider { get; set; }
    [SupplyParameterFromQuery] public string? TierKey { get; set; }
    [SupplyParameterFromQuery] public string? BillingPeriod { get; set; }
    [SupplyParameterFromQuery] public string? AddonSku { get; set; }
    [SupplyParameterFromQuery] public string[]? FeatureAddonSku { get; set; }
    [SupplyParameterFromQuery] public string? CreditAddonSku { get; set; }

    private readonly CheckoutInput _input = new();
    private string _tierName = "Plan";
    private string _summary = string.Empty;
    private bool _canPurchase;
    private bool _busy;
    private string? _error;
    private string? _resolvedSku;
    private BillingSystem _billingSystem = BillingSystem.None;
    private PersistingComponentStateSubscription _persistingSubscription;

    private string StateKey =>
        $"zenmeter-checkout-{_billingSystem.ToSlug()}-{Sku}-{TierKey}-{BillingPeriod}-{RequestedAddonSku}";

    protected override async Task OnInitializedAsync()
    {
        // A recognized billing system is always attempted here, even if it turns out to be
        // unconfigured or disabled - the try/catch below (and the purchase flow after it) surface
        // that as an on-page error instead of blocking navigation to the checkout route.
        _billingSystem = BillingSystems.FromSlug(BillingProvider) ?? Billing.Value.DefaultBillingSystem;
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistCheckoutState);
        if (ApplicationState.TryTakeFromJson<CheckoutPageState>(StateKey, out var restored)
            && restored is not null)
        {
            _resolvedSku = restored.ResolvedSku;
            _tierName = restored.TierName;
            _summary = restored.Summary;
            _canPurchase = restored.CanPurchase;
            _error = restored.Error;
            return;
        }

        var sku = await ResolveRequestedSku();
        _resolvedSku = sku;
        if (string.IsNullOrWhiteSpace(sku))
        {
            _error ??= "No offering selected.";
            return;
        }

        ZenmeterCheckoutInfo? info;
        try
        {
            info = await Demo.GetCheckoutInfo(_billingSystem, sku, RequestedAddonSku, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Zenmeter checkout details could not be loaded for SKU {Sku}.", sku);
            _error = "Check the Zenmeter catalog configuration and API connection, then retry.";
            return;
        }

        if (info is null)
        {
            _error = "Selected offering could not be found.";
            return;
        }

        _tierName = info.TierName;
        _summary = info.Summary;
        _canPurchase = info.CanPurchase;
        _error = info.UnavailableReason;
    }

    private async Task Submit()
    {
        var sku = _resolvedSku ?? await ResolveRequestedSku();
        if (string.IsNullOrWhiteSpace(sku))
        {
            _error ??= "No offering selected.";
            return;
        }

        if (!_canPurchase)
        {
            _error ??= "This offering is not available for purchase.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Demo.Purchase(
                _billingSystem,
                sku,
                RequestedAddonSku,
                _input.CustomerName,
                new ZenmeterUserInput(
                    _input.UserFirstName,
                    _input.UserLastName,
                    _input.UserEmail),
                _input.CheckoutRequestId,
                CancellationToken.None);
            if (result.Error is not null || result.SessionId is null)
            {
                _error = result.Error ?? "Purchase failed.";
                return;
            }

            // Persist the demo session client-side (localStorage) instead of an HttpOnly cookie.
            await Storage.SetAsync(SessionStorageKey.Zenmeter, result.SessionId);
            Nav.NavigateTo(result.RedirectUrl ?? DemoRoutes.ZenmeterWorkspace, forceLoad: result.RedirectUrl is not null);
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class CheckoutInput
    {
        [Required(ErrorMessage = "Enter a customer name before completing purchase.")]
        public string CustomerName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter the user's first name.")]
        [StringLength(50, ErrorMessage = "First name cannot exceed 50 characters.")]
        public string UserFirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter the user's last name.")]
        [StringLength(50, ErrorMessage = "Last name cannot exceed 50 characters.")]
        public string UserLastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter the user's email address.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        [StringLength(100, ErrorMessage = "Email cannot exceed 100 characters.")]
        public string UserEmail { get; set; } = string.Empty;

        public string CheckoutRequestId { get; set; } = $"zmchk_{Guid.NewGuid():N}";
    }

    private async Task<string?> ResolveRequestedSku()
    {
        if (!string.IsNullOrWhiteSpace(Sku))
        {
            return Sku;
        }

        if (string.IsNullOrWhiteSpace(TierKey))
        {
            return null;
        }

        var period = ZenmeterOfferingPeriods.FromSlug(BillingPeriod) == ZenmeterOfferingPeriod.Yearly
            ? ZenmeterOfferingPeriod.Yearly
            : ZenmeterOfferingPeriod.Monthly;
        ZenmeterCatalogPricing pricing;
        try
        {
            pricing = await Catalog.GetPricing(_billingSystem, CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Zenmeter pricing catalog could not be loaded while resolving checkout SKU.");
            _error = "Check the Zenmeter catalog configuration and API connection, then retry.";
            return null;
        }

        var tier = pricing.Tiers.FirstOrDefault(candidate =>
            string.Equals(candidate.Key, TierKey, StringComparison.OrdinalIgnoreCase));
        return tier?.Offerings.FirstOrDefault(offering =>
            offering is { IsVisible: true, IsTrial: false } && offering.Period == period)?.Sku;
    }

    private string? RequestedAddonSku
    {
        get
        {
            var addonSkus = ParseSkus(AddonSku)
                .Concat(FeatureAddonSku ?? [])
                .Concat(ParseSkus(CreditAddonSku))
                .Where(sku => !string.IsNullOrWhiteSpace(sku))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();

            return addonSkus.Length == 0 ? null : string.Join(",", addonSkus);
        }
    }

    private static IEnumerable<string> ParseSkus(string? skus) =>
        (skus ?? string.Empty)
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private string SubmitLabel => _billingSystem == BillingSystem.None
        ? "Create subscription"
        : "Buy subscription";

    private Task PersistCheckoutState()
    {
        ApplicationState.PersistAsJson(
            StateKey,
            new CheckoutPageState(_resolvedSku, _tierName, _summary, _canPurchase, _error));
        return Task.CompletedTask;
    }

    public void Dispose() => _persistingSubscription.Dispose();

    private sealed record CheckoutPageState(
        string? ResolvedSku,
        string TierName,
        string Summary,
        bool CanPurchase,
        string? Error);

}
