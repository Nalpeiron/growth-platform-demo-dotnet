@page "/elevate/saas/billing/return"
@implements IDisposable
@inject IZenmeterDemo Demo
@inject NavigationManager Nav
@inject BrowserStorage Storage

<PageTitle>Nalpeiron Growth Platform Demo Account - Billing Return</PageTitle>

<TopBar/>

<main class="mx-auto max-w-2xl px-6 py-16">
    <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">@Eyebrow</p>
        <h1 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900">Preparing your workspace</h1>
        <p class="mt-3 text-sm text-slate-600">@_message</p>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p class="mt-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800">@_error</p>
        }
    </div>
</main>

@code {
    [SupplyParameterFromQuery] public string? SessionId { get; set; }
    [SupplyParameterFromQuery] public string? ProviderOrderRefId { get; set; }
    [SupplyParameterFromQuery] public string? ProviderSubscriptionRefId { get; set; }
    [SupplyParameterFromQuery] public string? TopUpOperationId { get; set; }

    private string _message = "Waiting for Zenmeter provisioning to complete.";
    private string? _error;
    private readonly CancellationTokenSource _disposalCts = new();

    private string Eyebrow => string.IsNullOrWhiteSpace(TopUpOperationId)
        ? "Payment received"
        : "Top-up in progress";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var cancellationToken = _disposalCts.Token;
        try
        {
            var sessionId = !string.IsNullOrWhiteSpace(SessionId)
                ? SessionId
                : await Storage.GetAsync(SessionStorageKey.Zenmeter);
            if (string.IsNullOrWhiteSpace(sessionId))
            {
                // No session at all - there's no offering/billing-system context to resume a specific
                // checkout, so send the user back to the start of the flow.
                Nav.NavigateTo(DemoRoutes.Products);
                return;
            }

            await Storage.SetAsync(SessionStorageKey.Zenmeter, sessionId);
            if (!string.IsNullOrWhiteSpace(TopUpOperationId))
            {
                await WaitForTopUp(sessionId, TopUpOperationId, cancellationToken);
                return;
            }

            await WaitForSubscription(sessionId, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task WaitForSubscription(string sessionId, CancellationToken cancellationToken)
    {
        var startedAt = DateTimeOffset.UtcNow;
        while (true)
        {
            var status = await Demo.GetBillingStatus(
                sessionId,
                ProviderOrderRefId,
                ProviderSubscriptionRefId,
                cancellationToken);
            if (status.Status == ZenmeterCheckoutStatuses.Completed && !string.IsNullOrWhiteSpace(status.SubscriptionId))
            {
                Nav.NavigateTo(DemoRoutes.ZenmeterWorkspace);
                return;
            }

            if (status.Status == ZenmeterCheckoutStatuses.Cancelled)
            {
                Nav.NavigateTo(DemoRoutes.ZenmeterCheckoutFor(status.BillingSystem));
                return;
            }

            if (DateTimeOffset.UtcNow - startedAt > TimeSpan.FromSeconds(status.TimeoutSeconds))
            {
                _error = status.Error ?? "Payment is complete, but provisioning has not finished yet. This page can be refreshed to retry.";
                StateHasChanged();
                return;
            }

            _message = "Payment is complete. Waiting for the Zenmeter subscription to appear.";
            StateHasChanged();
            await Task.Delay(TimeSpan.FromSeconds(status.PollIntervalSeconds), cancellationToken);
        }
    }

    private async Task WaitForTopUp(
        string sessionId,
        string operationId,
        CancellationToken cancellationToken)
    {
        _message = "Waiting for your credit top-up to be provisioned.";
        StateHasChanged();
        var startedAt = DateTimeOffset.UtcNow;
        while (true)
        {
            var status = await Demo.GetTopUpStatus(
                sessionId,
                operationId,
                ProviderOrderRefId,
                cancellationToken);
            if (status.Status == ZenmeterCheckoutStatuses.Completed)
            {
                Nav.NavigateTo(DemoRoutes.ZenmeterWorkspace);
                return;
            }

            if (status.Status == ZenmeterCheckoutStatuses.Missing)
            {
                _error = status.Error ?? "Top-up checkout could not be found.";
                StateHasChanged();
                return;
            }

            if (status.Status == ZenmeterCheckoutStatuses.Failed)
            {
                _error = status.Error ?? "The top-up payment could not be verified.";
                StateHasChanged();
                return;
            }

            if (DateTimeOffset.UtcNow - startedAt > TimeSpan.FromSeconds(status.TimeoutSeconds))
            {
                _error = status.Error
                         ?? "Your workspace update has started, but the credit top-up has not been provisioned yet. This page can be refreshed to retry.";
                StateHasChanged();
                return;
            }

            await Task.Delay(TimeSpan.FromSeconds(status.PollIntervalSeconds), cancellationToken);
        }
    }

    public void Dispose()
    {
        _disposalCts.Cancel();
        _disposalCts.Dispose();
    }
}
