@page "/elevate/billing/return"
@implements IDisposable
@inject IElevateDemo Demo
@inject NavigationManager Nav
@inject BrowserStorage Storage

<PageTitle>Nalpeiron Growth Platform Demo Account - Billing Return</PageTitle>

<TopBar/>

<main class="mx-auto max-w-2xl px-6 py-16">
    <div class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        @* Provisioning can still fail after payment, so the heading follows the outcome instead of
           promising a workspace under an error message. *@
        <p class="text-xs font-semibold uppercase tracking-widest @(HasError ? "text-amber-700" : "text-indigo-600")">
            @(HasError ? "Provisioning incomplete" : "Payment received")
        </p>
        <h1 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900">
            @(HasError ? "Checkout could not be completed" : "Preparing your workspace")
        </h1>
        @if (HasError)
        {
            <p class="mt-4 rounded-lg bg-amber-50 px-3 py-2 text-sm text-amber-800">@_error</p>
        }
        else
        {
            <p class="mt-3 text-sm text-slate-600">@_message</p>
        }
    </div>
</main>

@code {
    [SupplyParameterFromQuery] public string? SessionId { get; set; }
    [SupplyParameterFromQuery] public string? ProviderOrderRefId { get; set; }
    [SupplyParameterFromQuery] public string? ProviderSubscriptionRefId { get; set; }

    private string _message = "Waiting for Zentitle provisioning to complete.";
    private string? _error;
    private readonly CancellationTokenSource _disposalCts = new();

    private bool HasError => !string.IsNullOrWhiteSpace(_error);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var cancellationToken = _disposalCts.Token;
        try
        {
            var sessionId = !string.IsNullOrWhiteSpace(SessionId)
                ? SessionId
                : await Storage.GetAsync(SessionStorageKey.Zentitle);
            if (string.IsNullOrWhiteSpace(sessionId))
            {
                Nav.NavigateTo(DemoRoutes.Products);
                return;
            }

            await Storage.SetAsync(SessionStorageKey.Zentitle, sessionId);
            await WaitForProvisioning(sessionId, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task WaitForProvisioning(string sessionId, CancellationToken cancellationToken)
    {
        var startedAt = DateTimeOffset.UtcNow;
        while (true)
        {
            var status = await Demo.GetBillingStatus(
                sessionId,
                ProviderOrderRefId,
                ProviderSubscriptionRefId,
                cancellationToken);
            if (status.Status == ZentitleCheckoutStatuses.Completed &&
                !string.IsNullOrWhiteSpace(status.EntitlementGroupId))
            {
                Nav.NavigateTo(DemoRoutes.ZentitleWorkspace);
                return;
            }

            if (status.Status is ZentitleCheckoutStatuses.Missing or ZentitleCheckoutStatuses.Failed)
            {
                _error = status.Error ?? "Zentitle checkout could not be completed.";
                StateHasChanged();
                return;
            }

            if (DateTimeOffset.UtcNow - startedAt > TimeSpan.FromSeconds(status.TimeoutSeconds))
            {
                _error = status.Error ??
                         (string.IsNullOrWhiteSpace(ProviderOrderRefId)
                             ? "The billing provider did not return an order reference. Return to checkout and try again."
                             : "Payment is complete, but Zentitle provisioning has not finished yet. Refresh this page to retry.");
                StateHasChanged();
                return;
            }

            _message = "Payment is complete. Waiting for the Zentitle entitlement to appear.";
            StateHasChanged();
            await Task.Delay(TimeSpan.FromSeconds(status.PollIntervalSeconds), cancellationToken);
        }
    }

    public void Dispose()
    {
        _disposalCts.Cancel();
        _disposalCts.Dispose();
    }

}
