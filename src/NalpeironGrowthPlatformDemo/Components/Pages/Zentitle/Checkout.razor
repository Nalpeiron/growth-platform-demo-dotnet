@page "/elevate/checkout"
@page "/elevate/{BillingProvider}/checkout"
@inject IElevateDemo Demo
@inject NavigationManager Nav
@inject BrowserStorage Storage
@inject Microsoft.Extensions.Options.IOptions<DemoProductsOptions> ProductsOptions
@inject IZentitleBillingProviderRegistry BillingProviders

<PageTitle>Nalpeiron Growth Platform Demo Account — Checkout</PageTitle>

<TopBar/>

<main class="mx-auto max-w-2xl px-6 py-12">
    <div class="text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-indigo-600">Payment</p>
        @if (BillingLogoPath is { } billingLogoPath)
        {
            <div class="mt-3 flex justify-center">
                <img src="@billingLogoPath" alt="@BillingDisplayName"
                     class="h-7 w-auto max-w-[170px] object-contain"/>
            </div>
        }
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900">@_planName</h1>
        <p class="mt-2 text-slate-500">@_planSummary</p>
        <p class="mt-2 text-xs font-semibold uppercase tracking-widest text-indigo-600">@BillingDisplayName billing</p>
    </div>

    <EditForm Model="_input" FormName="zentitle-checkout" OnValidSubmit="Submit"
              class="mx-auto mt-8 max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <DataAnnotationsValidator/>
        <label class="block">
            <span class="text-sm font-medium text-slate-700">Customer name</span>
            <InputText @bind-Value="_input.CustomerName" maxlength="120" placeholder="Acme Corp"
                       class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"/>
        </label>
        <ValidationMessage For="() => _input.CustomerName" class="mt-1 block text-sm text-rose-600"/>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="mt-3 rounded-lg bg-rose-50 px-3 py-2 text-sm text-rose-700">@_error</p>
        }

        <div class="mt-6 flex items-center justify-end gap-3">
            <a role="button" href="@SafeCancelUrl"
               class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                Cancel
            </a>
            <SpinnerButton Type="submit" Variant="primary" Pill="false"
                           Busy="@_busy" Disabled="@(!_canPurchase)"
                           Label="@(_isTrial ? "Start free trial" : "Complete purchase")"
                           BusyLabel="@(_isTrial ? "Starting…" : "Processing…")"/>
        </div>
    </EditForm>
</main>

@code {
    [SupplyParameterFromQuery] public string? OfferingId { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [Parameter] public string? BillingProvider { get; set; }

    private readonly CheckoutInput _input = new();
    private string _planName = "Plan";
    private string _planSummary = string.Empty;
    private bool _isTrial;
    private BillingPeriod _period = BillingPeriod.Yearly;
    private bool _canPurchase;
    private bool _busy;
    private string? _error;
    private BillingSystem _billingSystem = BillingSystem.None;
    private string? _loadedCheckoutKey;

    private string BillingDisplayName =>
        CurrentCapabilities.UsesExternalCheckout ? _billingSystem.DisplayName() : "Standard";

    private string CancelUrl =>
        _period == BillingPeriod.Perpetual
            ? $"{DemoRoutes.ZentitlePricingFor(_billingSystem)}?period=perpetual"
            : DemoRoutes.ZentitlePricingFor(_billingSystem);

    private string SafeCancelUrl =>
        LocalRedirectGuard.IsSafeLocalPath(ReturnUrl) ? ReturnUrl! : CancelUrl;

    private string? BillingLogoPath =>
        !CurrentCapabilities.UsesExternalCheckout
            ? null
            : ProductsOptions.Value.Items
                .FirstOrDefault(product => string.Equals(product.Key, "zentitle", StringComparison.OrdinalIgnoreCase))
                ?.Variants.FirstOrDefault(variant => variant.BillingSystem == _billingSystem)
                ?.LogoPath;

    private ZentitleBillingCapabilities CurrentCapabilities =>
        BillingProviders.GetCapabilities(_billingSystem);

    protected override void OnParametersSet()
    {
        var routedBillingSystem = DemoRoutes.ZentitleBillingSystemForRoute(
            new Uri(Nav.Uri).AbsolutePath,
            BillingProvider);
        if (routedBillingSystem is not null && BillingProviders.Find(routedBillingSystem.Value) is not null)
        {
            _billingSystem = routedBillingSystem.Value;
            return;
        }

        // A provider route Zentitle does not serve yet - continue on the default checkout.
        _billingSystem = BillingSystem.None;
        Nav.NavigateTo(DemoRoutes.ZentitleCheckoutFallback(OfferingId, ReturnUrl), replace: true);
    }

    protected override async Task OnParametersSetAsync()
    {
        var checkoutKey = $"{_billingSystem.ToSlug()}:{OfferingId}";
        if (string.Equals(_loadedCheckoutKey, checkoutKey, StringComparison.Ordinal))
        {
            return;
        }

        _loadedCheckoutKey = checkoutKey;
        _planName = "Plan";
        _planSummary = string.Empty;
        _isTrial = false;
        _period = BillingPeriod.Yearly;
        _canPurchase = false;
        _error = null;

        if (string.IsNullOrWhiteSpace(OfferingId))
        {
            _error = "No offering selected.";
            return;
        }

        CheckoutInfo? info;
        try
        {
            info = await Demo.GetCheckoutInfo(_billingSystem, OfferingId, CancellationToken.None);
        }
        catch (Exception exception)
        {
            _error = $"Could not load checkout: {exception.Message}";
            return;
        }

        if (info is null)
        {
            _error = "Selected offering could not be found.";
            return;
        }

        _planName = info.EditionName;
        _planSummary = info.Summary;
        _period = info.Period;
        _isTrial = info.IsTrial;
        _canPurchase = info.CanPurchase;
        _error = info.UnavailableReason;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(OfferingId))
        {
            _error = "No offering selected.";
            return;
        }

        if (!_canPurchase)
        {
            _error ??= "This offering is not available for purchase.";
            return;
        }

        _busy = true;
        try
        {
            var result = await Demo.Purchase(
                _billingSystem,
                OfferingId,
                _input.CustomerName,
                _input.CheckoutRequestId,
                CancellationToken.None);
            if (result.Error is not null || result.SessionId is null)
            {
                _error = result.Error ?? "Purchase failed.";
                return;
            }

            // Persist the demo session client-side (localStorage) instead of an HttpOnly cookie.
            await Storage.SetAsync(SessionStorageKey.Zentitle, result.SessionId);
            Nav.NavigateTo(
                result.RedirectUrl ?? DemoRoutes.ZentitleWorkspace,
                forceLoad: result.RedirectUrl is not null);
        }
        finally
        {
            _busy = false;
        }
    }

    public sealed class CheckoutInput
    {
        [Required(ErrorMessage = "Enter a customer name before completing purchase.")]
        public string CustomerName { get; set; } = string.Empty;

        public string CheckoutRequestId { get; set; } = $"chk_{Guid.NewGuid():N}";
    }

}
