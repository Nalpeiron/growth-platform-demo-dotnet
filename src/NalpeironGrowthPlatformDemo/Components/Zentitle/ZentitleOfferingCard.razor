@namespace NalpeironGrowthPlatformDemo.Components.Zentitle
@using NalpeironGrowthPlatformDemo.Nalpeiron.Zentitle.Generated

<article class="relative flex h-full flex-col rounded-2xl border bg-white p-8 shadow-sm transition
                @(IsFeatured ? "border-indigo-500 ring-1 ring-indigo-500 shadow-lg" : "border-slate-200")">
    @if (IsFeatured)
    {
        <div
            class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-indigo-600 px-4 py-1 text-xs font-bold uppercase tracking-wide text-white">
            Popular
        </div>
    }

    <h2 class="text-2xl font-bold text-slate-900">@Edition.EditionName</h2>
    <p class="mt-2 min-h-[4.5rem] text-sm leading-relaxed text-slate-500">@Edition.Description</p>

    @if (Plan is not null)
    {
        @if (Plan.IsPriceConfigured)
        {
            <div class="mt-4 flex items-baseline gap-2">
                <span class="text-sm font-semibold text-slate-400">USD</span>
                <span class="text-5xl font-extrabold tracking-tight text-slate-900">$@Plan.Price</span>
            </div>
            <p class="mt-1 text-sm text-slate-500">@Plan.BillingLabel</p>

            <a role="button"
               href="@($"{DemoRoutes.ZentitleCheckoutFor(SelectedBillingSystem)}?offeringId={Uri.EscapeDataString(Plan.OfferingId)}")"
               class="@(IsFeatured ? PrimaryButton : SecondaryButton) mt-6">
                Buy now
            </a>
        }
        else
        {
            <div class="mt-4 text-lg font-bold text-slate-700">Price not configured</div>
            <p class="mt-1 text-sm text-slate-500">@MissingPriceMessage</p>
            <span
                class="mt-6 inline-flex w-full items-center justify-center rounded-full border border-slate-200 px-6 py-3 text-sm font-semibold text-slate-300">
                Purchase unavailable
            </span>
        }
    }
    else
    {
        <div class="mt-4 flex items-baseline gap-2">
            <span class="text-sm text-slate-400">Not available for this billing period.</span>
        </div>
        <p class="mt-1 text-sm text-slate-500">&nbsp;</p>
        <span
            class="mt-6 inline-flex w-full items-center justify-center rounded-full border border-slate-200 px-6 py-3 text-sm font-semibold text-slate-300">
            Unavailable
        </span>
    }

    <div class="mt-3 h-5 text-center">
        @if (TrialPlan is not null)
        {
            <a href="@TrialCheckoutUrl"
               class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">
                or start a free trial
            </a>
        }
    </div>

    <div class="mt-6 border-t border-slate-100 pt-6">
        <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">What's included</div>
        <ul class="mt-4 space-y-2.5">
            @foreach (var highlight in Highlights)
            {
                <li class="flex items-start gap-2.5 text-sm text-slate-700">
                    <svg class="mt-0.5 h-4 w-4 flex-none text-emerald-500" viewBox="0 0 20 20" fill="currentColor"
                         aria-hidden="true">
                        <path fill-rule="evenodd"
                              d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z"
                              clip-rule="evenodd"/>
                    </svg>
                    <span>@highlight</span>
                </li>
            }
        </ul>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public EditionPricing Edition { get; set; } = null!;
    [Parameter] public BillingPeriod Period { get; set; } = BillingPeriod.Yearly;
    [Parameter] public BillingSystem SelectedBillingSystem { get; set; } = BillingSystem.None;
    [Parameter] public BillingSystem TrialBillingSystem { get; set; } = BillingSystem.None;
    [Parameter] public ZentitlePriceSource PriceSource { get; set; } = ZentitlePriceSource.Configured;
    [Parameter] public bool IsFeatured { get; set; }

    private const string PrimaryButton =
        "inline-flex w-full items-center justify-center rounded-full bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700";

    private const string SecondaryButton =
        "inline-flex w-full items-center justify-center rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-indigo-600 transition hover:bg-slate-50";

    private OfferingPlanPricing? Plan =>
        Edition.Plans.FirstOrDefault(p => !p.IsTrial && p.Period == Period);

    private OfferingPlanPricing? TrialPlan =>
        Edition.Plans.FirstOrDefault(p => p.IsTrial);

    private string TrialCheckoutUrl
    {
        get
        {
            return DemoRoutes.ZentitleTrialCheckoutFor(
                TrialBillingSystem,
                TrialPlan?.OfferingId ?? string.Empty,
                SelectedBillingSystem,
                Period);
        }
    }

    private string MissingPriceMessage =>
        PriceSource == ZentitlePriceSource.Configured
            ? $"Add SKU {Plan?.Sku} to Zentitle:Prices."
            : $"Configure SKU {Plan?.Sku} for {SelectedBillingSystem.DisplayName()} billing.";

    private IEnumerable<string> Highlights
    {
        get
        {
            // Usage count + element pool first, boolean (enabled only) last.
            var metered = Edition.Features
                .Where(f => f.Type != FeatureType.Bool)
                .OrderBy(f => f.Type == FeatureType.UsageCount ? 0 : 1)
                .Select(f => $"{f.Value} {f.Name}");

            var booleans = Edition.Features
                .Where(f => f.Type == FeatureType.Bool && f.Value != 0)
                .Select(f => f.Name);

            return metered.Concat(booleans);
        }
    }

}
