@namespace NalpeironGrowthPlatformDemo.Components.Zentitle

<section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm lg:col-span-2">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Boolean features</h2>
    <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var feature in Features)
        {
            <div class="flex items-center justify-between rounded-xl border px-4 py-3.5 @(feature.Enabled ? "border-emerald-200 bg-emerald-50" : "border-slate-200 bg-slate-50")">
                <div>
                    <div class="text-sm font-semibold text-slate-800">@feature.Name</div>
                    <div class="font-mono text-xs text-slate-400">@feature.Key</div>
                </div>
                <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold @(feature.Enabled ? "bg-emerald-600 text-white" : "bg-slate-300 text-slate-600")">
                    @(feature.Enabled ? "On" : "Off")
                </span>
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WorkspaceFeature> Features { get; set; } = [];
}
