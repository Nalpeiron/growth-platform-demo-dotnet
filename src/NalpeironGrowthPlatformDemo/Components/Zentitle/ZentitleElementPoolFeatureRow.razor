@namespace NalpeironGrowthPlatformDemo.Components.Zentitle

<div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3.5">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <div class="text-sm font-semibold text-slate-800">@Feature.Name</div>
            <div class="font-mono text-xs text-slate-400">@Feature.Key</div>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-sm font-semibold text-slate-700">@Feature.Used / @Feature.Value</span>
            <span class="rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-semibold text-sky-700">Element pool</span>
        </div>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-end gap-x-8 gap-y-3">
        <EditForm Model="_checkoutAmount" FormName="@($"pco-{Feature.Key}")"
                  OnValidSubmit="CheckoutAsync"
                  class="flex flex-wrap items-center justify-end gap-2 sm:flex-nowrap">
            <span class="shrink-0 text-sm font-semibold text-slate-600">Consume</span>
            <InputNumber @bind-Value="_checkoutAmount.Amount" min="1"
                         class="w-20 shrink-0 rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"/>
            <span class="shrink-0 text-sm font-medium text-slate-500">units</span>
            <SpinnerButton Type="submit" Variant="primary" Width="w-40"
                           Busy="@(BusyAction == $"consume-{Feature.Key}")"
                           Disabled="@(IsBusy || (Feature.Value > 0 && Feature.Used >= Feature.Value))"
                           Label="Consume now" BusyLabel="Consuming..." />
        </EditForm>
        <EditForm Model="_returnAmount" FormName="@($"pret-{Feature.Key}")"
                  OnValidSubmit="ReturnAsync"
                  class="flex flex-wrap items-center justify-end gap-2 sm:flex-nowrap">
            <span class="shrink-0 text-sm font-semibold text-slate-600">Return</span>
            <InputNumber @bind-Value="_returnAmount.Amount" min="1"
                         class="w-20 shrink-0 rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"/>
            <span class="shrink-0 text-sm font-medium text-slate-500">units</span>
            <SpinnerButton Type="submit" Variant="outline" Width="w-40"
                           Busy="@(BusyAction == $"return-{Feature.Key}")"
                           Disabled="@(IsBusy || Feature.Used <= 0)"
                           Label="Return now" BusyLabel="Returning..." />
        </EditForm>
    </div>
</div>

@code {
    private readonly AmountInput _checkoutAmount = new();
    private readonly AmountInput _returnAmount = new();

    [Parameter, EditorRequired] public WorkspaceFeature Feature { get; set; } = null!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? BusyAction { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnCheckout { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnReturn { get; set; }

    private async Task CheckoutAsync()
    {
        await OnCheckout.InvokeAsync(_checkoutAmount.Amount);
        _checkoutAmount.Amount = 1;
    }

    private async Task ReturnAsync()
    {
        await OnReturn.InvokeAsync(_returnAmount.Amount);
        _returnAmount.Amount = 1;
    }

    private sealed class AmountInput
    {
        [Range(1, int.MaxValue, ErrorMessage = "Enter a positive amount.")]
        public int Amount { get; set; } = 1;
    }
}
