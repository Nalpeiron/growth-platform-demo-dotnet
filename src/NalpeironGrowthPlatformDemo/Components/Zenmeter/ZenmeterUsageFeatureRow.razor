@namespace NalpeironGrowthPlatformDemo.Components.Zenmeter

<div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3.5">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-4">
        <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
                <div class="text-sm font-semibold text-slate-800">@Feature.Name</div>
                <span class="rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-semibold text-indigo-700">
                    @FeatureBadge
                </span>
            </div>
            <div class="mt-2 font-mono text-xs text-slate-400">@Feature.Key</div>
        </div>

        <EditForm Model="_amount" FormName="@($"zm-consume-{Feature.Key}")"
                  OnValidSubmit="ConsumeAsync"
                  class="flex flex-wrap items-center justify-end gap-2 sm:flex-nowrap">
            <span class="shrink-0 text-sm font-semibold text-slate-600">Consume</span>
            <input type="number" @bind="_amount.Amount" @bind:event="oninput" min="1"
                   class="w-20 shrink-0 rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 shadow-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200"/>
            <span class="inline-flex w-48 shrink-0 items-baseline gap-1 truncate text-sm font-medium text-slate-500">
                <span>@QuantityUnitLabel</span>
                @if (Feature.ConversionRate.HasValue)
                {
                    <span class="text-xs font-semibold text-slate-400">@CostLabel</span>
                }
            </span>
            <SpinnerButton Type="submit" Variant="primary" Width="w-40"
                           Busy="@(BusyAction == $"consume-{Feature.Key}")"
                           Disabled="@(IsBusy || !Feature.Enabled)"
                           Label="Consume now" BusyLabel="Consuming..." />
        </EditForm>
    </div>
</div>

@code {
    private readonly AmountInput _amount = new();

    [Parameter, EditorRequired] public ZenmeterUsageFeatureView Feature { get; set; } = null!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? BusyAction { get; set; }
    [Parameter, EditorRequired] public EventCallback<int> OnConsume { get; set; }

    private string FeatureBadge =>
        Feature.ConversionRate.HasValue
            ? $"{FormatNumber(Feature.ConversionRate.Value)} {UnitLabel(Feature.ConversionRate.Value, Feature.MeterUnitName, Feature.MeterUnitPluralName)}"
            : Feature.MeterKey;

    private string QuantityUnitLabel =>
        _amount.Amount == 1 ? Singular(Feature.UnitPluralName) : Feature.UnitPluralName;

    private string CostLabel
    {
        get
        {
            if (!Feature.ConversionRate.HasValue)
            {
                return string.Empty;
            }

            var cost = _amount.Amount * Feature.ConversionRate.Value;
            var unit = UnitLabel(cost, Feature.MeterUnitName, Feature.MeterUnitPluralName);
            return $"({FormatNumber(cost)} {unit})";
        }
    }

    private async Task ConsumeAsync()
    {
        await OnConsume.InvokeAsync(_amount.Amount);
        _amount.Amount = 1;
    }

    private static string UnitLabel(decimal amount, string singular, string plural) =>
        amount == 1 ? singular : plural;

    private static string FormatNumber(decimal value) =>
        value % 1 == 0 ? value.ToString("N0") : value.ToString("N2");

    private static string Singular(string plural) =>
        plural.EndsWith('s') ? plural[..^1] : plural;

    private sealed class AmountInput
    {
        [Range(1, int.MaxValue, ErrorMessage = "Enter a positive amount.")]
        public int Amount { get; set; } = 1;
    }
}
