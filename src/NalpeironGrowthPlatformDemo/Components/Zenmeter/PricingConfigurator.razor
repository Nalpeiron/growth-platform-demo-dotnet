@namespace NalpeironGrowthPlatformDemo.Components.Zenmeter
@implements IDisposable
@inject IZenmeterPricingCatalog Catalog
@inject ILogger<PricingConfigurator> Logger
@inject NavigationManager Nav
@inject Microsoft.Extensions.Options.IOptions<DemoProductsOptions> ProductsOptions
@inject PersistentComponentState ApplicationState

@code {
    [Parameter, EditorRequired] public BillingSystem SelectedBillingSystem { get; set; }
}

<ActionErrorToast Title="Loading prices failed" Message="@_priceAlert" OnClose="ClearPriceAlert"/>

<main class="mx-auto max-w-6xl px-6 pb-48 pt-16">
    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="rounded-lg border border-rose-200 bg-rose-50 p-6 shadow-sm">
            <h1 class="text-xl font-bold text-rose-950">Zenmeter pricing is unavailable</h1>
            <p class="mt-2 text-sm text-rose-800">@_loadError</p>
            <div class="mt-5 flex flex-wrap gap-3">
                <button type="button" @onclick="LoadPricing"
                        class="inline-flex items-center justify-center rounded-lg bg-rose-700 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-rose-800">
                    Retry
                </button>
                <a role="button" href="@DemoRoutes.Products"
                   class="inline-flex items-center justify-center rounded-lg border border-rose-200 bg-white px-4 py-2.5 text-sm font-semibold text-rose-800 transition hover:bg-rose-100">
                    Back to products
                </a>
            </div>
        </div>
    }
    else if (_pricing is null)
    {
        <div class="rounded-lg border border-slate-200 bg-white p-6 text-sm font-medium text-slate-500 shadow-sm">
            Loading pricing...
        </div>
    }
    else
    {
        <div class="mx-auto max-w-3xl text-center">
            <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600">Zenmeter pricing</p>
            @if (BillingLogoPath is { } billingLogoPath)
            {
                <div class="mt-4 flex justify-center">
                    <img src="@billingLogoPath"
                         alt="@SelectedBillingSystem.DisplayName()"
                         class="h-7 w-auto max-w-[170px] object-contain"/>
                </div>
            }
            <h1 class="mt-3 text-5xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-6xl">@_pricing.ProductName</h1>
            <p class="mt-5 text-lg text-slate-500">
                Pick a plan for your growth team. Each tier includes a shared monthly credit balance, core workflow
                features, and optional add-ons for heavier campaign runs.
            </p>
        </div>

        <PricingPlanSelectionSection Pricing="_pricing"
                                     SelectedTierKey="@_tierKey"
                                     Period="@_period"
                                     TierPricesLoading="@_tierPricesLoading"
                                     TierPricesFailed="@_tierPricesFailed"
                                     PeriodChanged="SetPeriod"
                                     TierSelected="SelectTier"/>

        <FeatureAddonSelectionSection SelectedTierKey="@_tierKey"
                                      SelectedOffering="SelectedOffering"
                                      AddonsLoading="@_addonsLoading"
                                      AddonLoadError="@_addonLoadError"
                                      AddonPricesLoading="@_addonPricesLoading"
                                      AddonPricesFailed="@_addonPricesFailed"
                                      FeatureAddons="FeatureAddOns"
                                      SelectedFeatureAddons="_featureAddons"
                                      FeatureToggled="ToggleFeature"/>

        <CreditAddonSelectionSection SelectedTierKey="@_tierKey"
                                     SelectedOffering="SelectedOffering"
                                     MeterUnitPluralName="@_pricing.MeterUnitPluralName"
                                     AddonPricesLoading="@_addonPricesLoading"
                                     AddonPricesFailed="@_addonPricesFailed"
                                     PlanCredits="@PlanCredits"
                                     CreditIndex="@_creditIndex"
                                     CreditSteps="_creditSteps"
                                     SelectedCreditStep="@SelectedCreditStep"
                                     CreditAddOnUnavailableMessage="@CreditAddOnUnavailableMessage"
                                     CreditChanged="SetCredit"/>

        <PricingCheckoutSummaryBar Title="@SummaryTitle"
                                   Items="@SummaryItems"
                                   Total="@Total"
                                   PricesLoading="@PricesLoading"
                                   PricesFailed="@PricesFailed"
                                   Disabled="@(SelectedOffering is null || _addonsLoading || PricesLoading || PricesFailed)"
                                   Checkout="GoToCheckout"/>

        <div class="mt-8">
            <a role="button" href="@DemoRoutes.Products"
               class="inline-flex items-center justify-center rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                Back to products
            </a>
        </div>
    }
</main>

@code {
    private ZenmeterCatalogPricing? _pricing;
    private string? _loadError;
    private string? _addonLoadError;
    private string? _priceAlert;
    private bool _tierPricesLoading;
    private bool _tierPricesFailed;
    private bool _addonPricesLoading;
    private bool _addonPricesFailed;
    private bool _addonsLoading;
    private long _addonLoadVersion;
    private readonly CancellationTokenSource _componentCancellation = new();
    private CancellationTokenSource? _addonLoadCancellation;
    private bool _disposed;
    private PersistingComponentStateSubscription _persistingSubscription;

    private string StateKey => $"zenmeter-pricing-{SelectedBillingSystem.ToSlug()}";

    private string PriceBookStateKey => $"zenmeter-pricebook-{SelectedBillingSystem.ToSlug()}";

    private string? BillingLogoPath =>
        SelectedBillingSystem == BillingSystem.None
            ? null
            : ProductsOptions.Value.Items
                .SelectMany(product => product.Variants)
                .FirstOrDefault(variant => variant.BillingSystem == SelectedBillingSystem)
                ?.LogoPath;

    private string? _tierKey;
    private ZenmeterOfferingPeriod _period = ZenmeterOfferingPeriod.Monthly;
    private readonly HashSet<string> _featureAddons = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<ZenmeterAddonPricing> _compatibleAddons = [];
    private int _creditIndex;
    private List<ZenmeterCreditStep> _creditSteps = new();

    // The full billing price book, loaded once per screen and reused for both tiers and later
    // add-on selections so choosing an offering never re-fetches prices. Null means the active
    // provider has no bulk price listing (only FastSpring does), in which case the per-SKU
    // catalog overloads are used instead. Not persisted, so re-entering the screen loads fresh
    // prices from the billing provider.
    private IReadOnlyDictionary<string, BillingPrice>? _priceBook;
    private bool _priceBookLoaded;

    private async Task<IReadOnlyDictionary<string, BillingPrice>?> EnsurePriceBook(
        CancellationToken cancellationToken)
    {
        if (_priceBookLoaded)
        {
            return _priceBook;
        }

        _priceBook = await Catalog.TryGetPriceBook(SelectedBillingSystem, cancellationToken);
        _priceBookLoaded = true;
        return _priceBook;
    }

    protected override async Task OnInitializedAsync()
    {
        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistPricing);
        if (ApplicationState.TryTakeFromJson<ZenmeterCatalogPricing>(StateKey, out var restored)
            && restored is not null)
        {
            _pricing = restored;

            // Restore the price book captured during prerender so the interactive circuit reuses it
            // for later add-on selections instead of fetching the FastSpring catalogue a second time.
            if (ApplicationState.TryTakeFromJson<Dictionary<string, BillingPrice>>(
                    PriceBookStateKey, out var restoredPriceBook)
                && restoredPriceBook is not null)
            {
                _priceBook = new Dictionary<string, BillingPrice>(restoredPriceBook, StringComparer.OrdinalIgnoreCase);
                _priceBookLoaded = true;
            }

            RebuildCreditSteps();
            return;
        }

        await LoadPricing();
    }

    private async Task LoadPricing()
    {
        var cancellationToken = _componentCancellation.Token;
        _loadError = null;
        _addonLoadError = null;
        _priceAlert = null;
        _tierPricesLoading = true;
        _tierPricesFailed = false;
        _addonPricesLoading = false;
        _addonPricesFailed = false;

        try
        {
            var priceBook = await EnsurePriceBook(cancellationToken);
            _pricing = priceBook is not null
                ? await Catalog.GetPricing(priceBook, cancellationToken)
                : await Catalog.GetPricing(SelectedBillingSystem, cancellationToken);
            RebuildCreditSteps();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Zenmeter pricing catalog could not be loaded.");
            _pricing = null;
            _tierKey = null;
            _compatibleAddons = [];
            _featureAddons.Clear();
            RebuildCreditSteps();
            _loadError = "Check the Zenmeter catalog configuration and API connection, then retry.";
            _tierPricesFailed = true;
            _priceAlert = "Tier prices could not be loaded from the billing system. Check the billing provider configuration and retry.";
        }
        finally
        {
            _tierPricesLoading = false;
            if (!_disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private IReadOnlyList<ZenmeterAddonPricing> FeatureAddOns =>
        _compatibleAddons
            .Where(addon => addon.IsVisible
                            && addon.Type == ZenmeterAddonType.FeatureBundle)
            .OrderBy(addon => addon.SortOrder)
            .ToList();

    private IEnumerable<ZenmeterAddonPricing> CreditAddOnsForPeriod =>
        CreditAddOnCandidatesForPeriod
            .Where(addon => addon.IsVisible)
            .OrderBy(addon => addon.Amount)
            .ThenBy(addon => addon.SortOrder);

    private IEnumerable<ZenmeterAddonPricing> CreditAddOnCandidatesForPeriod =>
        _compatibleAddons
            .Where(addon => addon is { Amount: > 0 }
                            && addon.Type == ZenmeterAddonType.MeterTopUp
                            && addon.RenewalBehavior == ZenmeterRenewalBehavior.RenewsWithSubscription
                            && addon.Period.AppliesTo(_period));

    private ZenmeterTierPricing? SelectedTier =>
        _pricing?.Tiers.FirstOrDefault(tier => string.Equals(tier.Key, _tierKey, StringComparison.OrdinalIgnoreCase));

    private ZenmeterOfferingPricing? SelectedOffering =>
        SelectedTier?.Offerings.FirstOrDefault(offering =>
            offering.IsVisible && !offering.IsTrial && offering.Period == _period);

    private long PlanCredits => SelectedTier?.IncludedMeterAmount ?? 0;

    private ZenmeterCreditStep SelectedCreditStep =>
        _creditSteps.Count == 0 ? default : _creditSteps[Math.Clamp(_creditIndex, 0, _creditSteps.Count - 1)];

    private string SummaryTitle =>
        SelectedTier is null
            ? "Select a plan"
            : $"{SelectedTier.Name} {_period.DisplayName()}";

    private string SummaryItems
    {
        get
        {
            if (_addonsLoading)
            {
                return "Loading available add-ons...";
            }

            var parts = FeatureAddOns
                .Where(addon => _featureAddons.Contains(addon.Sku))
                .Select(addon => addon.Name)
                .ToList();

            var credit = SelectedCreditStep;
            if (!string.IsNullOrEmpty(credit.Sku))
            {
                parts.Add(credit.Name);
            }

            return parts.Count == 0 ? "No add-ons selected." : string.Join(" + ", parts);
        }
    }

    private int Total =>
        (SelectedOffering?.Price ?? 0)
        + FeatureAddOns.Where(addon => _featureAddons.Contains(addon.Sku)).Sum(addon => addon.Price)
        + SelectedCreditStep.Price;

    private bool PricesLoading =>
        _tierPricesLoading || _addonPricesLoading;

    private bool PricesFailed =>
        _tierPricesFailed || _addonPricesFailed;

    private string CreditAddOnUnavailableMessage =>
        CreditAddOnCandidatesForPeriod.Any()
            ? "Recurring credit add-ons are available for this plan, but their prices were not resolved from the selected billing provider."
            : "No recurring credit add-ons are available for this plan and billing period.";

    private async Task SetPeriod(ZenmeterOfferingPeriod period)
    {
        var normalizedPeriod = period == ZenmeterOfferingPeriod.Yearly
            ? ZenmeterOfferingPeriod.Yearly
            : ZenmeterOfferingPeriod.Monthly;

        if (_period == normalizedPeriod)
        {
            return;
        }

        _period = normalizedPeriod;
        await LoadCompatibleAddons();
    }

    private async Task SelectTier(string tierKey)
    {
        if (string.Equals(_tierKey, tierKey, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _tierKey = tierKey;
        await LoadCompatibleAddons();
    }

    private void ToggleFeature(string sku)
    {
        if (!_featureAddons.Add(sku))
        {
            _featureAddons.Remove(sku);
        }
    }

    private void SetCredit(int index) =>
        _creditIndex = Math.Clamp(index, 0, Math.Max(0, _creditSteps.Count - 1));

    private void RebuildCreditSteps()
    {
        var steps = new List<ZenmeterCreditStep>
        {
            new(string.Empty, "No additional credits", 0, 0, _period == ZenmeterOfferingPeriod.Yearly ? "billed yearly" : "per month")
        };

        steps.AddRange(CreditAddOnsForPeriod.Select(addon =>
            new ZenmeterCreditStep(addon.Sku, addon.Name, addon.Amount, addon.Price, addon.BillingLabel)));

        _creditSteps = steps;
        _creditIndex = Math.Clamp(_creditIndex, 0, _creditSteps.Count - 1);
    }

    private async Task LoadCompatibleAddons()
    {
        var loadVersion = ++_addonLoadVersion;
        CancelAddonLoad();
        var offering = SelectedOffering;

        if (offering is null)
        {
            _compatibleAddons = [];
            _featureAddons.Clear();
            _addonLoadError = null;
            _addonPricesLoading = false;
            _addonPricesFailed = false;
            _addonsLoading = false;
            RebuildCreditSteps();
            return;
        }

        var loadCancellation = CancellationTokenSource.CreateLinkedTokenSource(_componentCancellation.Token);
        _addonLoadCancellation = loadCancellation;
        var cancellationToken = loadCancellation.Token;
        var selectedCreditSku = SelectedCreditStep.Sku;
        _addonsLoading = true;
        _addonLoadError = null;
        _addonPricesLoading = true;
        _addonPricesFailed = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var priceBook = await EnsurePriceBook(cancellationToken);
            var compatibleAddons = priceBook is not null
                ? await Catalog.GetCompatibleAddons(offering.Sku, priceBook, cancellationToken)
                : await Catalog.GetCompatibleAddons(offering.Sku, SelectedBillingSystem, cancellationToken);
            if (loadVersion != _addonLoadVersion)
            {
                return;
            }

            _compatibleAddons = compatibleAddons;
            _featureAddons.RemoveWhere(sku => !_compatibleAddons.Any(addon =>
                string.Equals(addon.Sku, sku, StringComparison.OrdinalIgnoreCase)));
            RebuildCreditSteps();
            RestoreSelectedCredit(selectedCreditSku);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            if (loadVersion != _addonLoadVersion)
            {
                return;
            }

            Logger.LogError(ex, "Zenmeter compatible add-ons could not be loaded for SKU {Sku}.", offering.Sku);
            _compatibleAddons = [];
            _featureAddons.Clear();
            _addonPricesFailed = true;
            _addonLoadError = "Add-ons could not be loaded for this plan. You can retry by selecting the plan again.";
            _priceAlert = "Add-on prices could not be loaded from the billing system. Check the billing provider configuration and retry.";
        }
        finally
        {
            if (ReferenceEquals(_addonLoadCancellation, loadCancellation))
            {
                _addonLoadCancellation = null;
                loadCancellation.Dispose();
                _addonsLoading = false;
                _addonPricesLoading = false;
                RebuildCreditSteps();
                RestoreSelectedCredit(selectedCreditSku);
                if (!_disposed)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private void ClearPriceAlert() =>
        _priceAlert = null;

    private Task PersistPricing()
    {
        if (_pricing is not null)
        {
            ApplicationState.PersistAsJson(StateKey, _pricing);
        }

        if (_priceBook is not null)
        {
            ApplicationState.PersistAsJson(PriceBookStateKey, _priceBook);
        }

        return Task.CompletedTask;
    }

    public void Dispose()
    {
        _disposed = true;
        _persistingSubscription.Dispose();
        CancelAddonLoad();
        _componentCancellation.Cancel();
        _componentCancellation.Dispose();
    }

    private void CancelAddonLoad()
    {
        var cancellation = _addonLoadCancellation;
        _addonLoadCancellation = null;
        if (cancellation is null)
        {
            return;
        }

        cancellation.Cancel();
        cancellation.Dispose();
    }

    private void RestoreSelectedCredit(string selectedCreditSku)
    {
        if (string.IsNullOrEmpty(selectedCreditSku))
        {
            _creditIndex = 0;
            return;
        }

        var selectedCreditIndex = _creditSteps.FindIndex(step =>
            string.Equals(step.Sku, selectedCreditSku, StringComparison.OrdinalIgnoreCase));
        _creditIndex = Math.Max(0, selectedCreditIndex);
    }

    private void GoToCheckout()
    {
        if (SelectedOffering is null || _addonsLoading || PricesLoading || PricesFailed)
        {
            return;
        }

        var query = new List<string> { $"sku={Uri.EscapeDataString(SelectedOffering.Sku)}" };

        foreach (var sku in _featureAddons)
        {
            query.Add($"featureAddonSku={Uri.EscapeDataString(sku)}");
        }

        var credit = SelectedCreditStep;
        if (!string.IsNullOrEmpty(credit.Sku))
        {
            query.Add($"creditAddonSku={Uri.EscapeDataString(credit.Sku)}");
        }

        Nav.NavigateTo($"{DemoRoutes.ZenmeterCheckoutFor(SelectedBillingSystem)}?{string.Join("&", query)}");
    }

}
