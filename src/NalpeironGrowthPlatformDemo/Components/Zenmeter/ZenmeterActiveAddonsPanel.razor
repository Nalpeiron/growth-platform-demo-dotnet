@namespace NalpeironGrowthPlatformDemo.Components.Zenmeter

<section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
    <div class="flex items-start justify-between gap-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Active add-ons</h2>
        <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@Addons.Count active</span>
    </div>

    @if (Addons.Count > 0)
    {
        <div class="mt-5 space-y-3">
            @foreach (var addon in Addons)
            {
                <div class="rounded-xl border border-indigo-100 bg-indigo-50 px-4 py-3">
                    <div class="text-sm font-semibold text-indigo-950">@addon.Name</div>
                    <div class="mt-1 text-xs font-semibold text-indigo-600">@addon.TermLabel</div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="mt-5 rounded-xl border border-dashed border-slate-200 bg-slate-50 px-4 py-5 text-sm text-slate-500">
            No active add-ons yet.
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ZenmeterAddonView> Addons { get; set; } = [];
}
