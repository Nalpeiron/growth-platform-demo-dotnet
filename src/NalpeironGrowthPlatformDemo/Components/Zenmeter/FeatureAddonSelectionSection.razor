@namespace NalpeironGrowthPlatformDemo.Components.Zenmeter

<section id="step-2" class="mt-14 border-t border-slate-200 pt-10">
    <div class="flex items-center gap-3">
        <span class="rounded-md bg-slate-950 px-3 py-2 text-sm font-bold text-white">Step 2</span>
        <h2 class="text-2xl font-bold text-slate-900">Add additional features</h2>
    </div>

    @if (string.IsNullOrWhiteSpace(SelectedTierKey))
    {
        <div
            class="mt-6 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-sm font-medium text-slate-500">
            Select a plan to continue.
        </div>
    }
    else if (SelectedOffering is null)
    {
        <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-6 text-sm font-medium text-amber-800">
            This plan is not available for the selected billing period because its price is not configured.
        </div>
    }
    else if (AddonsLoading)
    {
        <div class="relative mt-6 min-h-44" role="status" aria-live="polite">
            <span class="sr-only">Loading add-ons for the selected plan...</span>
            @if (FeatureAddons.Count > 0)
            {
                <div class="pointer-events-none grid gap-5 opacity-50 lg:grid-cols-3" aria-hidden="true">
                    @foreach (var addon in FeatureAddons)
                    {
                        <FeatureAddonCard @key="addon.Sku"
                                          Addon="addon"
                                          Selected="false"
                                          PriceLoading="true"
                                          PriceLoadFailed="false"
                                          OnToggle="FeatureToggled"/>
                    }
                </div>
            }
            else
            {
                <div class="grid gap-5 lg:grid-cols-3" aria-hidden="true">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="h-44 animate-pulse rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
                            <div class="h-3 w-20 rounded bg-slate-200"></div>
                            <div class="mt-5 h-5 w-2/3 rounded bg-slate-200"></div>
                            <div class="mt-4 h-3 w-full rounded bg-slate-100"></div>
                            <div class="mt-2 h-3 w-4/5 rounded bg-slate-100"></div>
                        </div>
                    }
                </div>
            }
            <div class="pointer-events-none absolute inset-x-0 top-4 flex justify-center" aria-hidden="true">
                <span
                    class="rounded-full border border-indigo-100 bg-white/95 px-4 py-2 text-xs font-semibold text-indigo-700 shadow-sm">
                    Updating add-ons...
                </span>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(AddonLoadError))
    {
        <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm font-medium text-amber-800">
            @AddonLoadError
        </div>
    }
    else if (FeatureAddons.Count == 0)
    {
        <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-6 text-sm font-medium text-slate-500">
            No additional feature add-ons are available for this plan.
        </div>
    }
    else
    {
        <div class="mt-6 grid gap-5 lg:grid-cols-3">
            @foreach (var addon in FeatureAddons)
            {
                <FeatureAddonCard @key="addon.Sku"
                                  Addon="addon" Selected="@(SelectedFeatureAddons.Contains(addon.Sku))"
                                  PriceLoading="@AddonPricesLoading"
                                  PriceLoadFailed="@AddonPricesFailed"
                                  OnToggle="FeatureToggled"/>
            }
        </div>
    }
</section>

@code {
    [Parameter] public string? SelectedTierKey { get; set; }
    [Parameter] public ZenmeterOfferingPricing? SelectedOffering { get; set; }
    [Parameter] public bool AddonsLoading { get; set; }
    [Parameter] public string? AddonLoadError { get; set; }
    [Parameter] public bool AddonPricesLoading { get; set; }
    [Parameter] public bool AddonPricesFailed { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ZenmeterAddonPricing> FeatureAddons { get; set; } = [];
    [Parameter, EditorRequired] public ISet<string> SelectedFeatureAddons { get; set; } = new HashSet<string>();
    [Parameter, EditorRequired] public EventCallback<string> FeatureToggled { get; set; }
}
