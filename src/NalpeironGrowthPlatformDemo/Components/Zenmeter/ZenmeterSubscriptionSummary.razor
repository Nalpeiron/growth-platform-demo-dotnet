@namespace NalpeironGrowthPlatformDemo.Components.Zenmeter

<section class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm lg:col-span-2">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-400">Subscription</h2>
            <span
                class="mt-3 inline-flex rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide @SubscriptionStatusClass(View.Status)">@View.Status</span>
        </div>
        <div class="grid gap-3 text-right text-sm sm:grid-cols-3">
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Tier</div>
                <div class="mt-1 font-semibold text-slate-800">@View.TierName</div>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Billing</div>
                <div class="mt-1 font-semibold text-slate-800">@View.BillingPeriod</div>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-400">Next renewal</div>
                <div class="mt-1 font-semibold text-slate-800">@DateOrDash(View.NextRenewalAt)</div>
            </div>
        </div>
    </div>

    @if (View.CustomerUrl is not null || View.SubscriptionUrl is not null)
    {
        <div
            class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-slate-100 pt-4 text-sm font-semibold text-indigo-600">
            <span class="text-xs font-semibold uppercase tracking-wide text-slate-400">Open in Zenmeter</span>
            @if (View.CustomerUrl is not null)
            {
                <a href="@View.CustomerUrl" target="_blank" rel="noopener" class="hover:text-indigo-700">Customer
                    &nearr;</a>
            }
            @if (View.SubscriptionUrl is not null)
            {
                <a href="@View.SubscriptionUrl" target="_blank" rel="noopener" class="hover:text-indigo-700">Subscription
                    details &nearr;</a>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public ZenmeterWorkspaceView View { get; set; } = null!;

    private static string DateOrDash(DateTimeOffset? value) =>
        value?.ToString("MMM d, yyyy") ?? "-";

    private static string SubscriptionStatusClass(string status)
    {
        var normalized = ReferenceId.Slug(status);
        if (normalized.Contains("grace", StringComparison.OrdinalIgnoreCase))
        {
            return "bg-amber-100 text-amber-700";
        }

        return string.Equals(normalized, "active", StringComparison.OrdinalIgnoreCase)
            ? "bg-emerald-100 text-emerald-700"
            : "bg-slate-100 text-slate-700";
    }

}
