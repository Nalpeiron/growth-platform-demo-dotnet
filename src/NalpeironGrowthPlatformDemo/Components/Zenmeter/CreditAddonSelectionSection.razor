@namespace NalpeironGrowthPlatformDemo.Components.Zenmeter
@using System.Globalization

<section id="step-3" class="mt-14 border-t border-slate-200 pt-10">
    <div class="flex items-center gap-3">
        <span class="rounded-md bg-slate-950 px-3 py-2 text-sm font-bold text-white">Step 3</span>
        <h2 class="text-2xl font-bold text-slate-900">Add more credits</h2>
    </div>

    @if (string.IsNullOrWhiteSpace(SelectedTierKey))
    {
        <div
            class="mt-6 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-6 text-sm font-medium text-slate-500">
            Select a plan to continue.
        </div>
    }
    else if (SelectedOffering is null)
    {
        <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-6 text-sm font-medium text-amber-800">
            Select a billing period with a configured plan price before adding credits.
        </div>
    }
    else
    {
        <div
            class="mt-6 rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition-opacity @(AddonPricesLoading ? "pointer-events-none opacity-60" : string.Empty)"
            aria-busy="@AddonPricesLoading">
            <div class="flex flex-wrap items-start justify-between gap-5">
                <div>
                    <h3 class="text-xl font-bold text-slate-900">Credits</h3>
                    <p class="mt-1 text-sm text-slate-500">Credits are shared across users. Select how many
                        additional monthly @MeterUnitPluralName your team needs.</p>
                </div>
                <div class="text-right">
                    @if (AddonPricesLoading)
                    {
                        <div class="ml-auto h-9 w-24 animate-pulse rounded bg-slate-100"></div>
                        <div class="ml-auto mt-2 h-3 w-20 animate-pulse rounded bg-slate-100"></div>
                    }
                    else if (AddonPricesFailed)
                    {
                        <div class="text-sm font-bold text-slate-700">Price unavailable</div>
                        <div class="mt-1 text-xs font-semibold text-slate-500">Billing price could not be loaded</div>
                    }
                    else
                    {
                        <div class="text-3xl font-extrabold text-slate-900">$@SelectedCreditStep.Price</div>
                        <div class="mt-1 text-xs font-semibold text-slate-500">@SelectedCreditStep.Billing</div>
                    }
                </div>
            </div>

            <div class="mt-8 text-2xl font-extrabold tracking-tight text-slate-900">
                @CompactCredits(PlanCredits) (selected plan)
                + @CompactCredits(SelectedCreditStep.Amount) credits/mo
            </div>

            @if (CreditSteps.Count <= 1)
            {
                <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm font-medium text-amber-800">
                    @CreditAddOnUnavailableMessage
                </div>
            }
            else
            {
                <div class="relative mt-6 h-20" role="radiogroup" aria-label="Additional credits">
                    <div class="absolute inset-x-0 top-4 h-3 rounded-full bg-slate-200" aria-hidden="true"></div>
                    <div class="absolute left-0 top-4 h-3 rounded-full bg-indigo-500 transition-[width]"
                         style="width:@CreditSelectionPercent"
                         aria-hidden="true"></div>

                    @for (var i = 0; i < CreditSteps.Count; i++)
                    {
                        var index = i;
                        var step = CreditSteps[index];
                        <label class="absolute top-0 h-20 cursor-pointer"
                               style="@CreditHitAreaStyle(index)">
                            <input type="radio"
                                   name="creditStep"
                                   value="@index"
                                   checked="@(index == CreditIndex)"
                                   disabled="@AddonPricesLoading"
                                   @onchange="() => CreditChanged.InvokeAsync(index)"
                                   aria-label="@($"{step.Amount:N0} additional credits per month")"
                                   class="peer absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0"/>
                            <span
                                class="absolute top-1 h-9 w-9 rounded-full border-4 border-white shadow-md transition-colors peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-600 peer-focus-visible:ring-offset-2 @(index == CreditIndex ? "bg-indigo-600" : "bg-slate-300")"
                                style="@CreditStepAnchorStyle(index)"
                                aria-hidden="true"></span>
                            <span
                                class="absolute top-14 whitespace-nowrap text-xs font-semibold transition-colors @(index == CreditIndex ? "text-indigo-600" : "text-slate-500")"
                                style="@CreditStepAnchorStyle(index)"
                                aria-hidden="true">@CompactCredits(step.Amount)/mo</span>
                        </label>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public string? SelectedTierKey { get; set; }
    [Parameter] public ZenmeterOfferingPricing? SelectedOffering { get; set; }
    [Parameter] public string MeterUnitPluralName { get; set; } = "credits";
    [Parameter] public bool AddonPricesLoading { get; set; }
    [Parameter] public bool AddonPricesFailed { get; set; }
    [Parameter] public long PlanCredits { get; set; }
    [Parameter] public int CreditIndex { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ZenmeterCreditStep> CreditSteps { get; set; } = [];
    [Parameter] public ZenmeterCreditStep SelectedCreditStep { get; set; }
    [Parameter] public string CreditAddOnUnavailableMessage { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback<int> CreditChanged { get; set; }

    private string CreditSelectionPercent =>
        CreditSteps.Count <= 1
            ? "0%"
            : ((double)CreditIndex / (CreditSteps.Count - 1) * 100)
            .ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private string CreditHitAreaStyle(int index)
    {
        var interval = 100d / (CreditSteps.Count - 1);
        var zIndex = 30 - Math.Abs(index - CreditIndex);
        if (index < CreditIndex)
        {
            return index == 0
                ? $"left:0;width:{Percent(interval)};z-index:{zIndex}"
                : $"left:calc({Percent(index * interval)} - 1.125rem);width:calc({Percent(interval)} + 1.125rem);z-index:{zIndex}";
        }

        if (index > CreditIndex)
        {
            return index == CreditSteps.Count - 1
                ? $"left:{Percent((index - 1) * interval)};right:0;z-index:{zIndex}"
                : $"left:{Percent((index - 1) * interval)};width:calc({Percent(interval)} + 1.125rem);z-index:{zIndex}";
        }

        if (index == 0)
        {
            return "left:0;width:2.25rem;z-index:40";
        }

        if (index == CreditSteps.Count - 1)
        {
            return "right:0;width:2.25rem;z-index:40";
        }

        return $"left:calc({Percent(index * interval)} - 1.125rem);width:2.25rem;z-index:40";
    }

    private string CreditStepAnchorStyle(int index) =>
        index switch
        {
            0 => "left:0",
            _ when index == CreditSteps.Count - 1 => "right:0",
            _ when index < CreditIndex => "left:1.125rem;transform:translateX(-50%)",
            _ when index > CreditIndex => "right:1.125rem;transform:translateX(50%)",
            _ => "left:50%;transform:translateX(-50%)"
        };

    private static string Percent(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string CompactCredits(long amount)
    {
        if (amount >= 1000)
        {
            var compact = amount / 1000d;
            return compact % 1 == 0
                ? compact.ToString("0", CultureInfo.InvariantCulture) + "K"
                : compact.ToString("0.0", CultureInfo.InvariantCulture) + "K";
        }

        return amount.ToString("N0");
    }

}
