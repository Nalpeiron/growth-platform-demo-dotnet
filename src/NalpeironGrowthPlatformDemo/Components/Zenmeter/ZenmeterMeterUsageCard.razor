@namespace NalpeironGrowthPlatformDemo.Components.Zenmeter

<div>
    <div class="flex items-baseline justify-between gap-6">
        <div>
            <div class="text-sm font-semibold text-slate-800">@Meter.Name</div>
            <div class="font-mono text-xs text-slate-400">@Meter.Key</div>
        </div>
        <div class="text-right">
            <div class="text-4xl font-extrabold text-slate-900">@Meter.Available.ToString("N0")</div>
            <div class="text-sm text-slate-500">left</div>
        </div>
    </div>
    <div class="mt-3 flex flex-wrap justify-between gap-2 text-sm font-medium text-slate-500">
        <span>@Meter.Used.ToString("N0") used</span>
        <span>@Meter.Limit.ToString("N0") total @Meter.UnitPluralName</span>
    </div>
    <div class="mt-4 h-5 w-full overflow-hidden rounded-full bg-slate-200">
        <div class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-amber-500"
             style="width:@Meter.UsedPercent%"></div>
    </div>

    @if (HasBreakdown)
    {
        <div class="mt-6 grid gap-3 border-t border-slate-100 pt-5 md:grid-cols-2">
            @foreach (var source in Meter.Sources)
            {
                <div class="rounded-xl border border-slate-100 bg-slate-50 px-4 py-3.5">
                    <div class="flex items-center justify-between gap-3 text-xs">
                        <span>
                            <span class="block font-semibold text-slate-600">@source.Label</span>
                            @if (!string.IsNullOrWhiteSpace(source.TermLabel))
                            {
                                <span class="mt-0.5 block font-semibold text-indigo-500">@source.TermLabel</span>
                            }
                        </span>
                        <span class="text-right text-slate-500">
                            <span class="block">@source.Available.ToString("N0") left</span>
                            <span class="mt-0.5 block text-[11px] font-semibold text-slate-400">@Pct(source.Used, source.Limit)% used</span>
                        </span>
                    </div>
                    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
                        <div class="h-full rounded-full @(source.Used <= 0 ? "bg-indigo-300" : "bg-indigo-500")"
                             style="width:@SourceProgressWidth(source)"></div>
                    </div>
                    <div class="mt-2 flex justify-between text-[11px] font-medium text-slate-400">
                        <span>@source.Used.ToString("N0") used</span>
                        <span>@source.Limit.ToString("N0") @source.UnitPluralName</span>
                    </div>
                </div>
            }
        </div>
    }

    @if (Meter.ShowTopUp && TopUpOptions.Count > 0)
    {
        <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 px-4 py-4">
            <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                    <h3 class="text-sm font-semibold text-slate-900">Top up credits</h3>
                    <p class="mt-1 text-sm text-slate-600">Credit usage is at @Meter.UsedPercent%. Add a credit pack to this subscription.</p>
                </div>
            </div>
            <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var option in TopUpOptions)
                {
                    <div class="rounded-lg border border-amber-300 bg-white px-4 py-4 text-sm shadow-sm">
                        <div class="font-semibold text-slate-900">@option.Name</div>
                        <div class="mt-2 text-sm text-slate-700">@option.Amount.ToString("N0") credits</div>
                        <div class="mt-1 text-xs text-slate-500">
                            @(option.IsRecurring ? "Recurring add-on" : "One-time add-on") · @option.BillingLabel
                        </div>
                        <div class="mt-3 flex w-full items-center justify-between gap-3">
                            <span class="text-sm font-semibold text-slate-900">$@option.Price.ToString("0.00")</span>
                            <SpinnerButton Variant="amber" Size="sm" Width="w-24"
                                           OnClick="() => OnAddTopUp.InvokeAsync(option.Sku)"
                                           Busy="@(BusyAction == $"topup-{option.Sku}")" Disabled="@IsBusy"
                                           Label="Buy now" BusyLabel="Buying..." />
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ZenmeterMeterUsageView Meter { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<ZenmeterTopUpOptionView> TopUpOptions { get; set; } = [];
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? BusyAction { get; set; }
    [Parameter, EditorRequired] public EventCallback<string> OnAddTopUp { get; set; }

    private bool HasBreakdown =>
        Meter.Sources.Count > 1 || Meter.Sources.Any(source => !string.Equals(source.Key, "base", StringComparison.OrdinalIgnoreCase));

    private static int Pct(decimal used, long value) =>
        value <= 0 ? 0 : (int)Math.Min(100, Math.Round((double)(used / value) * 100));

    private static string SourceProgressWidth(ZenmeterMeterSourceUsageView source)
    {
        var percent = Pct(source.Used, source.Limit);
        return percent == 0 && source.Limit > 0 ? "0.375rem" : $"{percent}%";
    }
}
