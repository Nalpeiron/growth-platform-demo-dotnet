# Used ONLY by docker-compose (host-side ${VAR} substitution -> container configuration vars).
# Local `dotnet run` does NOT read this file — it uses appsettings.Local.json.

# Shared Nalpeiron Growth Platform connection.
NALPEIRON_API_URL=https://[TENANT_NAME].api.nalpeiron.io
NALPEIRON_OAUTH_URL=https://[TENANT_NAME].keycloak.nalpeiron.io/realms/[TENANT_NAME]/protocol/openid-connect/token
NALPEIRON_TENANT_ID=t_xxxxxxxxxxxxxxxxxxxxxx
NALPEIRON_CLIENT_ID=<api-client-id>
NALPEIRON_CLIENT_SECRET=<api-client-secret>
NALPEIRON_WEB_URL=https://[TENANT_NAME].nalpeiron.io

# Zentitle (licensing) product.
ZENTITLE_PRODUCT_ID=prod_xxxxxxxxxxxxxxxxxxxxxx
ZENTITLE_EDITION_ORDER=Standard,Premium,Enterprise

# Zenmeter (SaaS metering) product.
ZENMETER_BUSINESS_MODEL_ID=zm-bm_xxxxxxxxxxxxxxxxxxxxxx

# Billing system used by Program.cs's debug pricing endpoint when none is specified.
# The product picker exposes the provider routes configured for each product regardless of this value.
BILLING_DEFAULT_SYSTEM=None
STRIPE_API_URL=https://api.stripe.com
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_ZENMETER_SUCCESS_URL=http://localhost:5080/elevate/saas/billing/return
STRIPE_ZENMETER_CANCEL_URL=http://localhost:5080/elevate/saas/stripe/checkout
STRIPE_ZENTITLE_SUCCESS_URL=http://localhost:5080/elevate/billing/return
STRIPE_ZENTITLE_CANCEL_URL=http://localhost:5080/elevate/stripe/checkout
FASTSPRING_API_URL=https://api.fastspring.com
FASTSPRING_ZENMETER_STOREFRONT_URL=<store>.test.onfastspring.com/<zenmeter-popup-checkout-id>
FASTSPRING_ZENTITLE_STOREFRONT_URL=<store>.test.onfastspring.com/<zentitle-popup-checkout-id>
FASTSPRING_API_USERNAME=<fastspring-api-username>
FASTSPRING_API_PASSWORD=<fastspring-api-password>
